# ============================================================================
# ФАЙЛ: terraform-module-lab/modules/disks/versions.tf
# РОЛЬ: дочерний модуль тоже должен объявлять провайдера, которым
#       пользуется. Иначе Terraform ищет hashicorp/yandex по умолчанию
#       и падает с "Invalid provider registry host".
# ============================================================================
terraform {
  required_providers {
    yandex = {
      # Тот же source, что и в корневом versions.tf.
      # Source должен совпадать, иначе Terraform увидит конфликт.
      source = "yandex-cloud/yandex"

      # Версия не указана — она наследуется от корневого модуля.
      # Указывать повторно не обязательно.
    }
  }
}