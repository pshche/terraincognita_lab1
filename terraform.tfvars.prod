# ============================================================================
# ФАЙЛ: terraform-module-lab/terraform.tfvars.prod
# РОЛЬ: значения переменных для окружения prod.
# ИСПОЛЬЗУЕТСЯ при запуске:
#   terraform apply -var-file="terraform.tfvars.prod"
# ОТЛИЧИЯ от dev:
#   - memory = 4 (вместо 2)
#   - disk_size = 20 (вместо 10)
#   - три SSD-диска (вместо двух HDD)
# ПЕРЕМЕННЫЕ ОБЪЯВЛЕНЫ в:
#   - terraform-module-lab/variables.tf
# ============================================================================

# Публичный SSH-ключ
ssh_public_key = "ssh-rsa  ps@MacBook-Pro-Pavel.local"

# В prod памяти больше, диски крупнее.
vm_specification = {
  web = {
    cores     = 2
    memory    = 4
    core_fraction = 20
    disk_size = 20
    boot_disk = "fd845dr9j4h2aaq1m6ko"
  }
  api = {
    cores     = 2
    memory    = 4
    core_fraction = 20
    disk_size = 20
    boot_disk = "fd845dr9j4h2aaq1m6ko"
  }
}

# Три SSD-диска — быстрее и дороже.
extra_disk_names = ["logs", "backup", "data"]
extra_disk_type  = "network-ssd"
extra_disk_size  = 50