# ============================================================================
# ФАЙЛ: terraform-module-lab/versions.tf
# РОЛЬ: корневой модуль, точка входа. Задаёт требования к версиям
#       Terraform и провайдеров, чтобы конфигурация одинаково собиралась
#       у студента, преподавателя и в CI.
# ВЫЗЫВАЕТСЯ: автоматически при `terraform init` в этой директории.
# ============================================================================
terraform {
  # Минимальная версия Terraform CLI. Если у пользователя старее —
  # Terraform откажется работать и не даст «случайно» сломать конфиг.
  required_version = ">= 1.5.0"

  # required_providers: какие провайдеры нужны и откуда их качать.
  required_providers {
    # Локальное имя провайдера. Используется в provider "yandex" (см. main.tf).
    yandex = {
      # Официальный провайдер Yandex Cloud в реестре Terraform.
      # НЕ hashicorp/yandex — такого не существует.
      source = "yandex-cloud/yandex"

      # Ограничение версий: "~> 0.100" разрешает обновления только
      # в пределах минорной 0.100.x (0.100.0, 0.100.1, ...), но не 0.101+.
      # Это защищает от ломающих изменений в новых минорных версиях.
      version = "~> 0.100"
    }
  }
}